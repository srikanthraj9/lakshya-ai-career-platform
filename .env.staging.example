# ==============================================================================
# LAKSHYA AI - STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.staging for staging deployment verification
# ==============================================================================

ENVIRONMENT=staging
DEBUG=false

# Database Configuration (Staging PostgreSQL + PgVector)
DATABASE_URL=postgresql://staging_user:staging_secure_password@staging-db.internal:5432/lakshyaai_staging

# Security & JWT
SECRET_KEY=staging_super_secure_32_byte_hex_secret_key_lakshya_ai
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Staging Allowed CORS Domains
CORS_ORIGINS=https://staging.lakshya.ai,https://staging-api.lakshya.ai

# Rate Limiting Controls
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE_AUTH=15
RATE_LIMIT_PER_MINUTE_AI=30

# Staging Super Admin Bootstrap
ADMIN_EMAILS=srikanthuppalapati09@gmail.com,staging-admin@lakshya.ai

# AI Inference Provider
AI_PROVIDER=gemini
AI_API_KEY=staging_gemini_api_key_placeholder
