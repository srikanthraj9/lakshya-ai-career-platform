# ==============================================================================
# LAKSHYA AI - BACKEND STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.staging or configure in deployment platform secret manager
# ==============================================================================

ENVIRONMENT=staging
DEBUG=false
APP_NAME=LakshyaAI-Staging

# Isolated Staging Database (PostgreSQL 15+ with pgvector)
# Must point to an isolated staging DB instance, never production Supabase
DATABASE_URL=postgresql://staging_user:staging_secure_password@staging-db.internal:5432/lakshyaai_staging
DIRECT_URL=postgresql://staging_user:staging_secure_password@staging-db.internal:5432/lakshyaai_staging

# Explicit confirmation flag required by Alembic safety guard for staging migrations
CONFIRM_STAGING_MIGRATION=true

# Security & JWT (Must be at least 32 characters in staging)
SECRET_KEY=staging_super_secure_32_byte_hex_secret_key_lakshya_ai
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins for Staging
CORS_ORIGINS=https://staging.lakshya.ai,https://staging-api.lakshya.ai,http://localhost:5173
FRONTEND_URL=https://staging.lakshya.ai

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Super Admin Bootstrap
ADMIN_EMAILS=srikanthuppalapati09@gmail.com,staging-admin@lakshya.ai

# AI Provider Settings
AI_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=staging_groq_api_key_placeholder
