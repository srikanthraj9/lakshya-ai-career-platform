# App Configuration
APP_NAME=LakshyaAI
DEBUG=True
FRONTEND_URL=http://127.0.0.1:5173

# JWT Authentication
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database (Supabase PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:your-db-password@localhost:5432/lakshyaai

# Supabase (Optional)
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_role_key

# Google OAuth 2.0 / OpenID Connect (OIDC) Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FRONTEND_URL=http://127.0.0.1:5173
GOOGLE_REDIRECT_URI=http://127.0.0.1:10000/api/auth/google/callback


# Email SMTP Settings (Optional for live delivery; in dev, verification links are printed in terminal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-app-password
SMTP_FROM_EMAIL=your-email@gmail.com


# AI & Embeddings (Optional)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=your_openai_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# LLM_MODEL=openai/gpt-4o-mini
# LLM_TIMEOUT_SECONDS=30
# LLM_AUX_TIMEOUT_SECONDS=30
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# Resume Optimization & LaTeX Settings
# RESUME_REWRITE_CHUNK_CHARS=8192
# RESUME_REWRITE_OUTPUT_DIR=storage/rewrites
# LATEX_COMMAND=pdflatex
# ENABLE_LLM_RESUME_FEEDBACK=true
# ENABLE_LLM_SKILL_EXTRACTION=true
