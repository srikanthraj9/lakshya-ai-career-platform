# ==============================================================================
# LAKSHYA AI - ROOT / FRONTEND ENVIRONMENT TEMPLATE
# Copy to .env.local or .env for local development
# ==============================================================================

# Application Environment: development | staging | production
VITE_APP_ENV=development

# Backend REST API Base URL
VITE_API_BASE_URL=http://127.0.0.1:10000/api

# Telemetry / Observability Mode: console | production | noop
VITE_TELEMETRY_MODE=console

# Optional Error Monitoring DSN (e.g. Sentry)
VITE_SENTRY_DSN=

# Feature Flags Override (comma-separated key=bool)
VITE_FEATURE_FLAGS=
